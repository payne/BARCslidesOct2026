{
  "name": "barc-slides-oct-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Marp slide deck: Never a Better Time to be a Ham",
  "scripts": {
    "build": "npm run build:html && npm run build:assets",
    "build:html": "npm run build:kc0wih && npm run build:2026oct15",
    "build:kc0wih": "marp --html --allow-local-files kc0wih.md -o docs/kc0wih.html",
    "build:2026oct15": "marp --html --allow-local-files 2026oct15.md -o docs/2026oct15.html",
    "build:assets": "node -e \"const fs=require('fs');fs.cpSync('kc0wih-assets','docs/kc0wih-assets',{recursive:true});fs.copyFileSync('index.html','docs/index.html')\"",
    "build:pdf": "marp kc0wih.md --allow-local-files --pdf -o docs/kc0wih.pdf",
    "serve": "marp --server --allow-local-files --port 8080 .",
    "watch": "marp kc0wih.md --html --allow-local-files --watch --preview",
    "watch:2026oct15": "marp --html --allow-local-files 2026oct15.md --watch --preview",
    "clean": "node -e \"require('fs').rmSync('docs',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1"
  }
}
